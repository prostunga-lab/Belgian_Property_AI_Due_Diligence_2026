# Copy to .env for local use (docker run --env-file .env ...). Never commit the real file.
SECRET_KEY=change-me-long-random-string
# DATABASE_URL=postgresql://user:pass@host:5432/dd      # default: SQLite in DATA_DIR
# DATA_DIR=./data
BASE_URL=http://localhost:8000                          # used in e-mailed links and Stripe redirects

# Production (APP_ENV=production refuses to start without these)
# APP_ENV=production
# FILE_ENCRYPTION_KEY=long-random-passphrase            # back it up: lost key = unrecoverable files
# INVITE_CODE=share-only-with-people-who-may-register
# COOKIE_SECURE=1

# Credits
FREE_CREDITS=6
PACK_CREDITS=20

# Optional AI reading (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

# E-mail (without SMTP_HOST, links are logged and confirmation is not enforced)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@your-domain.be

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
