# Copy to .env for local use (docker run --env-file .env ...). Never commit the real file.
SECRET_KEY=change-me-long-random-string
# DATABASE_URL=postgresql://user:pass@host:5432/dd      # default: SQLite in DATA_DIR
# DATA_DIR=./data
BASE_URL=http://localhost:8000                          # e-mailed links + Stripe redirects (on Railway: RAILWAY_PUBLIC_DOMAIN is used automatically)

# Production (APP_ENV=production refuses to start without these)
# APP_ENV=production
# FILE_ENCRYPTION_KEY=long-random-passphrase            # back it up: lost key = unrecoverable files
# INVITE_CODE=share-only-with-people-who-may-register
# COOKIE_SECURE=1

# Publisher identity shown on /about, /contact and in the footer. Only what you set is shown; nothing is invented.
# CONTACT_EMAIL=info@your-domain.be
# COMPANY_NAME=Your Company BV
# COMPANY_ADDRESS=Street 1, 9000 Gent
# COMPANY_ENTERPRISE_NUMBER=BE 0123.456.789
# COMPANY_PHONE=+32 9 123 45 67

# Pricing (unit = one complete dossier). Defaults shown; every value is optional.
FREE_CREDITS=1
DOSSIER_MAX_DOCUMENTS=25
MAX_FILES_PER_REQUEST=25
PRICES_VAT=incl
# PLAN_SINGLE_PRICE_EUR=29        # PLAN_<ID>_PRICE_EUR / PLAN_<ID>_DOSSIERS for single, pack5, agent, agency
# PLAN_PACK5_PRICE_EUR=75
# PLAN_AGENT_PRICE_EUR=49         # 15 dossiers / month
# PLAN_AGENCY_PRICE_EUR=149       # 60 dossiers / month
# DISCOUNT_SEMIANNUAL_PCT=5
# DISCOUNT_ANNUAL_PCT=10
PROCESSING_PROMISE_MINUTES=2      # displayed promise, checked by tests/test_promise.py

# Renovation plan: JSON file overriding the default indicative costs (see docs/RENOVATION.md)
# RENOVATION_COST_FILE=/data/renovation_costs.json

# Registration: set OPEN_REGISTRATION=1 and leave INVITE_CODE empty to let anyone sign up
# OPEN_REGISTRATION=1
# REGISTRATIONS_PER_IP_PER_DAY=5
# Free trial of the subscription plans (Stripe trial period; see docs/STRIPE.md)
# TRIAL_DAYS=3
# TRIAL_DOSSIERS=3

# Access requests (contact form): who may read /admin/requests (comma-separated e-mails of registered accounts)
# ADMIN_EMAILS=you@example.be
# HTTP security
# CSP_MODE=enforce                # enforce | report-only | off
# Rule set validation (docs/REGLES.md)
# RULES_VALIDATED=1

# Legal pages
# HOSTING_PROVIDER=Railway
# HOSTING_REGION=EU West
# LEGAL_REVIEWED=1                # hides the "draft, to be reviewed by a lawyer" banner

# Optional AI reading (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

# E-mail via an HTTPS API (use this on Railway trial/hobby plans, where outbound SMTP is blocked)
# RESEND_API_KEY=re_...
# MAIL_FROM=onboarding@resend.dev        # test sender: only delivers to your Resend account address

# E-mail via SMTP (without RESEND_API_KEY or SMTP_HOST, links are logged and confirmation is not enforced)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@your-domain.be

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
